#. Plugin Name of the plugin
#: buckmerce-for-plaid.php
msgid "Buckmerce – Bank Payments via Plaid for WooCommerce"
msgstr "Buckmerce – Bank Payments via Plaid for WooCommerce"

#. Description of the plugin
#: buckmerce-for-plaid.php
msgid "Secure Pay by Bank payments for WooCommerce using Plaid."
msgstr "Безопасная оплата с банковского счёта для WooCommerce через Plaid."

#. Author of the plugin
#: buckmerce-for-plaid.php
msgid "al5dy"
msgstr "al5dy"

