msgid "You are not allowed to do this."
msgstr "У вас нет прав на это действие."

#: src/Admin/ConfigurationStatus.php:46
msgid "Plaid Client ID and Secret"
msgstr "Plaid Client ID и Secret"

#: src/Admin/ConfigurationStatus.php:46
msgid "Enter both keys of the selected environment."
msgstr "Введите оба ключа выбранной среды."

#: src/Admin/ConfigurationStatus.php:47
msgid "Environment: Production (real money)"
msgstr "Среда: Production (реальные деньги)"

#: src/Admin/ConfigurationStatus.php:47
msgid "Environment: Sandbox (test mode)"
msgstr "Среда: Sandbox (тестовый режим)"

#: src/Admin/ConfigurationStatus.php:49
#: src/Admin/DiagnosticsPage.php:76
msgid "HTTPS"
msgstr "HTTPS"

#: src/Admin/ConfigurationStatus.php:49
msgid "Production requires HTTPS."
msgstr "Для Production требуется HTTPS."

#: src/Admin/ConfigurationStatus.php:51
msgid "Store currency USD"
msgstr "Валюта магазина — USD"

#: src/Admin/ConfigurationStatus.php:56
#: src/Admin/DiagnosticsPage.php:91
msgid "Link customization configured"
msgstr "Кастомизация Link настроена"

#: src/Admin/ConfigurationStatus.php:57
msgid "Create a Plaid Link customization with Account Select = “Enabled for one account” in the selected environment, then enter its name. Plaid Transfer UI requires it in Sandbox and Production."
msgstr "Создайте в выбранной среде кастомизацию Plaid Link с параметром Account Select = “Enabled for one account” и введите её название. Plaid Transfer UI требует её и в Sandbox, и в Production."

#. translators: %s: Plaid error code
#: src/Admin/ConfigurationStatus.php:61
#, php-format
msgid "Plaid rejected the last Link session (%s)"
msgstr "Plaid отклонил последнюю сессию Link (%s)"

#. translators: %s: Plaid error code
#: src/Admin/ConfigurationStatus.php:61
msgid "Check the Link customization name, that it is published and that its language matches the store language."
msgstr "Проверьте название кастомизации Link, что она опубликована и что её язык совпадает с языком магазина."

#: src/Admin/ConfigurationStatus.php:64
msgid "Database tables"
msgstr "Таблицы базы данных"

#: src/Admin/ConfigurationStatus.php:64
msgid "Deactivate and reactivate the plugin to recreate its tables."
msgstr "Деактивируйте и снова активируйте плагин, чтобы пересоздать его таблицы."

#: src/Admin/ConfigurationStatus.php:66
msgid "Webhook REST route"
msgstr "REST-маршрут вебхука"

#: src/Admin/ConfigurationStatus.php:71
#: src/Admin/ConfigurationStatus.php:73
msgid "Last Plaid connection test"
msgstr "Последняя проверка подключения к Plaid"

#: src/Admin/ConfigurationStatus.php:73
msgid "Not run yet: use “Test connection”."
msgstr "Ещё не выполнялась: нажмите «Проверить подключение»."

#: src/Admin/ConfigurationStatus.php:79
msgid "Pay by Bank offered at checkout"
msgstr "Оплата через банк предлагается при оформлении заказа"

#: src/Admin/ConfigurationStatus.php:79
msgid "Disabled: customers cannot choose Pay by Bank. Existing payments are still monitored."
msgstr "Отключено: покупатели не могут выбрать оплату через банк. Существующие платежи по-прежнему отслеживаются."

#: src/Admin/ConfigurationStatus.php:104
msgid "Action Scheduler available"
msgstr "Action Scheduler доступен"

#: src/Admin/ConfigurationStatus.php:104
msgid "Buckmerce cannot follow payments without WooCommerce Action Scheduler."
msgstr "Без WooCommerce Action Scheduler Buckmerce не может отслеживать платежи."

#: src/Admin/ConfigurationStatus.php:108
#: src/Admin/DiagnosticsPage.php:81
msgid "Reconciliation scheduled"
msgstr "Сверка запланирована"

#: src/Admin/ConfigurationStatus.php:108
msgid "It is scheduled automatically on the next admin or cron request."
msgstr "Она будет запланирована автоматически при следующем запросе админки или cron."

#: src/Admin/ConfigurationStatus.php:114
msgid "Background jobs running on time"
msgstr "Фоновые задачи выполняются вовремя"

#: src/Admin/ConfigurationStatus.php:117
msgid "Buckmerce jobs are overdue and WP-Cron is disabled (DISABLE_WP_CRON). Configure a server cron job that runs wp-cron.php or `wp action-scheduler run` every minute."
msgstr "Задачи Buckmerce просрочены, а WP-Cron отключён (DISABLE_WP_CRON). Настройте серверный cron, который каждую минуту запускает wp-cron.php или `wp action-scheduler run`."

#: src/Admin/ConfigurationStatus.php:118
msgid "Buckmerce jobs are overdue. WP-Cron runs only when the site gets visits; configure a server cron job for reliable payment updates."
msgstr "Задачи Buckmerce просрочены. WP-Cron работает только при посещениях сайта; для надёжного обновления платежей настройте серверный cron."

#: src/Admin/ConfigurationStatus.php:119
msgid "WP-Cron is disabled; a server cron job must run the scheduled actions."
msgstr "WP-Cron отключён; запланированные действия должен запускать серверный cron."

#: src/Admin/ConfigurationStatus.php:125
msgid "Last Plaid event sync failed"
msgstr "Последняя синхронизация событий Plaid завершилась ошибкой"

#: src/Admin/ConfigurationStatus.php:125
msgid "Plaid rejected the request: check the credentials with “Test connection”."
msgstr "Plaid отклонил запрос: проверьте учётные данные кнопкой «Проверить подключение»."

#: src/Admin/ConfigurationStatus.php:125
msgid "Buckmerce retries automatically with backoff."
msgstr "Buckmerce автоматически повторяет попытки с увеличивающимся интервалом."

#. translators: %d: number of payments
#: src/Admin/ConfigurationStatus.php:131
#, php-format
msgid "%d bank payment(s) cannot be monitored"
msgstr "Банковских платежей, которые невозможно отслеживать: %d"

#. translators: %d: number of payments
#: src/Admin/ConfigurationStatus.php:131
msgid "Plaid credentials are missing, so returns and refunds of existing payments are not detected."
msgstr "Учётные данные Plaid не заданы, поэтому ACH-возвраты и возвраты средств по существующим платежам не обнаруживаются."

#. translators: %d: number of payments
#: src/Admin/ConfigurationStatus.php:138
#, php-format
msgid "%d payment(s) belong to another Plaid account"
msgstr "Платежей, принадлежащих другому аккаунту Plaid: %d"

#. translators: %d: number of payments
#: src/Admin/ConfigurationStatus.php:138
msgid "They cannot be read with the current Client ID and are not monitored."
msgstr "Их нельзя прочитать с текущим Client ID, и они не отслеживаются."

