#: src/Admin/ConnectionTester.php:42
msgid "You are not allowed to run this check."
msgstr "У вас нет прав на запуск этой проверки."

#: src/Admin/ConnectionTester.php:112
msgid "Connected to Plaid Transfer. Plaid Ledger is enabled (leave Funding Account ID empty)."
msgstr "Подключено к Plaid Transfer. Plaid Ledger включён (оставьте Funding Account ID пустым)."

#: src/Admin/ConnectionTester.php:113
msgid "Connected to Plaid Transfer."
msgstr "Подключено к Plaid Transfer."

#: src/Admin/ConnectionTester.php:114
msgid "Configuration incomplete: enter the Client ID and Secret, save, then test again."
msgstr "Настройка не завершена: введите Client ID и Secret, сохраните и повторите проверку."

#. translators: %s: Plaid error code such as INVALID_API_KEYS
#: src/Admin/ConnectionTester.php:116
#, php-format
msgid "Invalid Plaid credentials (%s): check the Client ID and that the Secret belongs to the selected environment."
msgstr "Неверные учётные данные Plaid (%s): проверьте Client ID и то, что Secret относится к выбранной среде."

#. translators: %s: Plaid error code
#: src/Admin/ConnectionTester.php:118
#, php-format
msgid "Plaid Transfer is not enabled for this Plaid account/environment (%s). Request Transfer access in the Plaid Dashboard."
msgstr "Plaid Transfer не включён для этого аккаунта/среды Plaid (%s). Запросите доступ к Transfer в Plaid Dashboard."

#. translators: %s: Plaid error code
#: src/Admin/ConnectionTester.php:120
#, php-format
msgid "Plaid denied access to Transfer (%s). Your team may not be approved for this environment yet."
msgstr "Plaid отказал в доступе к Transfer (%s). Возможно, ваша команда ещё не одобрена для этой среды."

#: src/Admin/ConnectionTester.php:121
msgid "Plaid rate-limited the check. Wait a minute and test again."
msgstr "Plaid ограничил частоту запросов. Подождите минуту и повторите проверку."

#: src/Admin/ConnectionTester.php:122
msgid "Plaid is temporarily unavailable or returned an unexpected response. Try again later; see status.plaid.com."
msgstr "Plaid временно недоступен или вернул неожиданный ответ. Повторите позже; см. status.plaid.com."

#: src/Admin/ConnectionTester.php:123
msgid "Plaid could not be reached from this server (network error). Check outbound HTTPS connectivity and firewall rules."
msgstr "С этого сервера не удалось связаться с Plaid (сетевая ошибка). Проверьте исходящие HTTPS-соединения и правила файрвола."

#. translators: %s: Plaid error code
#: src/Admin/ConnectionTester.php:125
#, php-format
msgid "Plaid rejected the request (%s). Check the credentials, the environment and that Transfer is enabled for your account."
msgstr "Plaid отклонил запрос (%s). Проверьте учётные данные, среду и то, что Transfer включён для вашего аккаунта."

#: src/Admin/ConnectionTester.php:126
msgid "No connection test has been run."
msgstr "Проверка подключения ещё не выполнялась."

#: src/Admin/ConnectionTester.php:131
msgid "Link customization missing: Plaid Transfer UI requires one with Account Select “Enabled for one account” in this environment."
msgstr "Не задана кастомизация Link: Plaid Transfer UI требует в этой среде кастомизацию с параметром Account Select “Enabled for one account”."

#: src/Admin/ConnectionTester.php:132
msgid "Plaid Ledger is enabled, so remove the Funding Account ID (Plaid rejects it)."
msgstr "Plaid Ledger включён, поэтому удалите Funding Account ID (Plaid его отклоняет)."

#: src/Admin/ConnectionTester.php:133
msgid "No Plaid Ledger was found: enter your Funding Account ID from the Plaid Dashboard."
msgstr "Plaid Ledger не найден: введите Funding Account ID из Plaid Dashboard."

