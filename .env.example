# Local development variables for Buckmerce for Plaid test scripts.
# Copy to .env (gitignored — never commit it). scripts/lib/test-env.sh loads it automatically,
# and falls back to ~/.my.cnf for the database credentials.
# Values below are placeholders. Never put Production credentials here.

# Disposable test database server (scripts create and drop their own
# buckmerce_test_*, buckmerce_browser_*, buckmerce_check_* and buckmerce_sandbox_* databases).
BUCKMERCE_PLAID_TEST_DB_HOST=localhost
BUCKMERCE_PLAID_TEST_DB_USER=root
BUCKMERCE_PLAID_TEST_DB_PASSWORD=

# Optional version overrides for the disposable WordPress sites.
BUCKMERCE_PLAID_TEST_WP_VERSION=7.1.2
BUCKMERCE_PLAID_TEST_WC_VERSION=11.1.2

# Optional real Plaid Sandbox gate (scripts/test-sandbox-e2e.sh). Sandbox keys only:
# Plaid Dashboard → Developers → Keys → Sandbox. The username/password are the Plaid
# Sandbox test credentials shown in Link (user_good / pass_good by default).
BUCKMERCE_PLAID_SANDBOX_CLIENT_ID=
BUCKMERCE_PLAID_SANDBOX_SECRET=
BUCKMERCE_PLAID_SANDBOX_USERNAME=user_good
BUCKMERCE_PLAID_SANDBOX_PASSWORD=pass_good
# Name of a Sandbox Link customization with Account Select "Enabled for one account"
# (Plaid Dashboard → Link → Link Customization, Sandbox). Required: the gate exits 78 without it.
BUCKMERCE_PLAID_SANDBOX_LINK_CUSTOMIZATION=

# Optional public-HTTPS webhook gate: npm run test:sandbox:ngrok
# A reserved ngrok domain of your ngrok account (Dashboard → Domains), e.g.
# your-reserved-name.ngrok-free.dev. The ngrok agent must be installed and
# authenticated (ngrok config add-authtoken …, or NGROK_AUTHTOKEN).
BUCKMERCE_PLAID_NGROK_DOMAIN=
