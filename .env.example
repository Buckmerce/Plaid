# Copy this file to .env (already gitignored — never commit it), or run:
#   bash scripts/export-merchant-env.sh
# to populate it automatically from the live WordPress database settings.
#
# Used only by the manual, local-only merchant connectivity probe:
#   php tools/probe_paykassa_merchant_connectivity.php
# Never used in CI. Never used to settle a real payment: every request the
# probe makes hardcodes PayKassa's own sandbox test=1 flag.

# PayKassa SCI (merchant) credentials — WooCommerce > Settings > Payments > PayKassa
PAYKASSA_SANDBOX_SHOP_ID=
PAYKASSA_SANDBOX_SHOP_PASSWORD=

# PayKassa API credentials (optional — only needed for the API connectivity check)
PAYKASSA_SANDBOX_API_ID=
PAYKASSA_SANDBOX_API_PASSWORD=

# Public URL the store is reachable at right now (e.g. an ngrok tunnel to this local install)
PAYKASSA_PUBLIC_SITE_URL=https://ocelot-dribble-creature.ngrok-free.dev

# Optional overrides for the test-mode invoice probe (defaults: 30 / USDT / 1)
# System IDs are listed in src/PayKassa/PaymentSystemRegistry.php (30 = TRON_TRC20).
PAYKASSA_PROBE_SYSTEM_ID=
PAYKASSA_PROBE_CURRENCY=
PAYKASSA_PROBE_AMOUNT=

# The API connectivity check defaults to PayKassa's sandbox flag (test=1).
# If your API_ID/API_PASSWORD are only provisioned for Live mode, this check
# will report "provider_rejected" even with correct credentials. Set this to
# 0 to retry the same read-only check against Live instead.
PAYKASSA_PROBE_API_TEST_MODE=
