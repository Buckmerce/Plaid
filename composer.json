{
  "name": "al5dy/paybridge-for-plaid",
  "description": "PayBridge for Plaid — WooCommerce Pay by Bank using Plaid Transfer.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1",
    "firebase/php-jwt": "^7.0"
  },
  "require-dev": {
    "brianhenryie/strauss": "^0.30",
    "php-stubs/woocommerce-stubs": "^11.1",
    "php-stubs/wordpress-stubs": "^7.1",
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^10.5",
    "squizlabs/php_codesniffer": "^3.10"
  },
  "autoload": {
    "psr-4": {
      "PayBridge\\Plaid\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "PayBridge\\Plaid\\Tests\\": "tests/"
    },
    "files": [
      "vendor-prefixed/autoload.php"
    ]
  },
  "extra": {
    "strauss": {
      "target_directory": "vendor-prefixed",
      "namespace_prefix": "PayBridge\\Plaid\\Vendor\\",
      "classmap_prefix": "PayBridge_Plaid_Vendor_",
      "constant_prefix": "PAYBRIDGE_PLAID_VENDOR_",
      "packages": [
        "firebase/php-jwt"
      ],
      "delete_vendor_packages": false,
      "include_modified_date": false,
      "include_author": false
    }
  },
  "scripts": {
    "prefix-dependencies": "strauss",
    "post-install-cmd": [
      "@prefix-dependencies"
    ],
    "post-update-cmd": [
      "@prefix-dependencies"
    ],
    "test": "phpunit --colors=always",
    "test:integration": "bash scripts/test-integration.sh",
    "lint": "phpcs --standard=phpcs.xml.dist",
    "stan": "phpstan analyse --memory-limit=1G",
    "syntax": "find src tests paybridge-for-plaid.php uninstall.php -name '*.php' -not -path 'tests/phpstan-wp-root/*' -print0 | xargs -0 -n1 php -l"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "brianhenryie/strauss": false
    },
    "platform": {
      "php": "8.1.0"
    }
  }
}
