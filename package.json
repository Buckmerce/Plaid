{
  "name": "buckmerce-for-plaid",
  "version": "1.0.0",
  "private": true,
  "description": "Buckmerce – Bank Payments via Plaid for WooCommerce (front-end build).",
  "license": "GPL-2.0-or-later",
  "browserslist": [
    "defaults",
    "not IE 11"
  ],
  "targets": {
    "adminStyles": {
      "source": "resources/scss/admin-settings.scss",
      "distDir": "assets",
      "sourceMap": false
    },
    "paymentStyles": {
      "source": "resources/scss/payment-page.scss",
      "distDir": "assets",
      "sourceMap": false
    },
    "blocksScript": {
      "source": "resources/ts/blocks.ts",
      "distDir": "assets/build",
      "outputFormat": "global",
      "isLibrary": false,
      "sourceMap": false
    },
    "paymentScript": {
      "source": "resources/ts/payment-page.ts",
      "distDir": "assets/build",
      "outputFormat": "global",
      "isLibrary": false,
      "sourceMap": false
    },
    "adminScript": {
      "source": "resources/ts/admin-settings.ts",
      "distDir": "assets/build",
      "outputFormat": "global",
      "isLibrary": false,
      "sourceMap": false
    }
  },
  "scripts": {
    "clean": "rm -rf assets/admin-settings.css assets/payment-page.css assets/build assets/images .parcel-cache",
    "build:assets": "parcel build --no-content-hash --no-cache",
    "build:images": "bash scripts/copy-images.sh",
    "build": "npm run clean && npm run build:assets && npm run build:images",
    "watch": "parcel watch",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck && node --check assets/build/blocks.js && node --check assets/build/payment-page.js && node --check assets/build/admin-settings.js",
    "test": "npm run build && npm run lint && node --test tests/js/*.test.mjs",
    "test:e2e": "bash scripts/test-browser-e2e.sh",
    "test:integration": "bash scripts/test-integration.sh",
    "test:plugin-check": "bash scripts/test-plugin-check.sh",
    "test:sandbox": "bash scripts/test-sandbox-e2e.sh",
    "test:sandbox:ngrok": "bash scripts/test-sandbox-e2e.sh --ngrok",
    "plugin-zip": "npm run build && bash scripts/package.sh"
  },
  "devDependencies": {
    "@parcel/transformer-sass": "^2.16.4",
    "axe-core": "4.13.0",
    "parcel": "^2.16.4",
    "sass": "^1.104.1",
    "typescript": "^7.0.2"
  }
}
